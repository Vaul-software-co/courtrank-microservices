SPRING_PROFILES_ACTIVE=local,kafka
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/courtrank_auth
DATABASE_USERNAME=courtrank_auth_user
DATABASE_PASSWORD=change-me

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

JWT_PRIVATE_KEY=file:../secrets/jwt-private.pem
JWT_PUBLIC_KEY=file:../secrets/jwt-public.pem
PASSWORD_PEPPER=change-me

WEB_API_KEY=change-me
MOBILE_API_KEY=change-me

WORKER_ACCESS_SERVICE_URL=http://localhost:4000/internal
WORKER_ACCESS_SERVICE_API_KEY=

USER_SERVICE_URL=http://localhost:8082/internal
USER_SERVICE_API_KEY=change-me
INTERNAL_API_KEY=change-me

RESEND_API_KEY=
RESEND_FROM=CourtRank <noreply@getcourtrank.com>

AUTH_CLEANUP_ENABLED=true
AUTH_CLEANUP_CRON=0 0 3 * * *
AUTH_CLEANUP_ZONE=America/Bogota
AUTH_CLEANUP_SESSION_RETENTION=30d
AUTH_CLEANUP_VERIFICATION_TOKEN_RETENTION=7d

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For TLS/mTLS Kafka deployments:
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_TRUSTSTORE_LOCATION=/run/secrets/kafka.truststore.p12
# KAFKA_SSL_TRUSTSTORE_PASSWORD=change-me
# KAFKA_SSL_KEYSTORE_LOCATION=/run/secrets/kafka-auth-service.keystore.p12
# KAFKA_SSL_KEYSTORE_PASSWORD=change-me
# KAFKA_SSL_KEY_PASSWORD=change-me
KAFKA_AUTH_EVENTS_TOPIC=auth.events
KAFKA_AUDIT_EVENTS_TOPIC=audit.events
