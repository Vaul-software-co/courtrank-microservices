generator client {
  provider = "prisma-client-js"
  output   = "../generated/social"
}

datasource db {
  provider = "postgresql"
  url      = env("SOCIAL_DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model blocks {
  id         String   @id @db.Uuid
  blocker_id String   @db.Uuid
  blocked_id String   @db.Uuid
  created_at DateTime @db.Timestamptz(6)

  @@unique([blocker_id, blocked_id], map: "uq_blocks_pair")
  @@index([blocked_id], map: "idx_blocks_blocked_id")
  @@index([blocker_id], map: "idx_blocks_blocker_id")
}

model flyway_schema_history {
  installed_rank Int      @id(map: "flyway_schema_history_pk")
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(6)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model follows {
  id           String    @id @db.Uuid
  follower_id  String    @db.Uuid
  following_id String    @db.Uuid
  status       String    @db.VarChar(20)
  created_at   DateTime  @db.Timestamptz(6)
  accepted_at  DateTime? @db.Timestamptz(6)
  updated_at   DateTime  @db.Timestamptz(6)

  @@unique([follower_id, following_id], map: "uq_follows_pair")
  @@index([follower_id], map: "idx_follows_follower_id")
  @@index([following_id], map: "idx_follows_following_id")
  @@index([following_id, status], map: "idx_follows_following_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model social_counters {
  user_id                String   @id @db.Uuid
  followers_count        Int      @default(0)
  following_count        Int      @default(0)
  pending_requests_count Int      @default(0)
  blocked_count          Int      @default(0)
  created_at             DateTime @db.Timestamptz(6)
  updated_at             DateTime @db.Timestamptz(6)
}

model social_users {
  user_id           String    @id @db.Uuid
  name              String    @db.VarChar(100)
  username          String?   @db.VarChar(30)
  avatar_url        String?
  private_profile   Boolean
  active            Boolean
  deleted_at        DateTime? @db.Timestamptz(6)
  source_updated_at DateTime? @db.Timestamptz(6)
  synced_at         DateTime  @db.Timestamptz(6)
  created_at        DateTime  @db.Timestamptz(6)
  updated_at        DateTime  @db.Timestamptz(6)

  @@index([name, username], map: "idx_social_users_search")
  @@index([active, deleted_at], map: "idx_social_users_visible")
}
