# Docker Compose reads .env automatically for variable interpolation.
# Copy this file to .env for local/develop Compose variables.
# Runtime service secrets still live under ./secrets/.
#
# Kafka TLS/mTLS store passwords must match the values used when running:
# scripts/generate-kafka-tls-secrets.sh secrets
KAFKA_SSL_STORE_PASSWORD=change-me
KAFKA_SSL_KEY_PASSWORD=change-me
#
# See:
# - secrets/compose.prod.env.example
# - secrets/auth-service.env.example
# - secrets/user-service.env.example
# - secrets/social-service.env.example
# - secrets/auth-postgres.env.example
# - secrets/user-postgres.env.example
# - secrets/social-postgres.env.example
